            "type": "string"
          }
        },
        "required": [
          "ref",
          "object"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "object": {
            "additionalProperties": false,
            "properties": {
              "sha": {
                "type": "string"
              },
              "type": {
                "description": "Git object kind: commit, tag, tree, or blob.",
                "type": "string"
              }
            },
            "required": [
              "type",
              "sha"
            ],
            "type": [
              "null",
              "object"
            ]
          },
          "sha": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "tagger": {
            "additionalProperties": false,
