{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "readOnlyHint": false,
    "title": "Write operations on repository labels"
  },
  "description": "Perform write operations on repository labels. To set labels on issues, use the 'update_issue' tool.",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "additionalProperties": true,
    "properties": {
      "color": {
        "anyOf": [
          {
            "description": "Label color as 6-character hex code without '#' prefix (e.g., 'f29513'). Required for 'create', optional for 'update'.",
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Label color as 6-character hex code without '#' prefix (e.g., 'f29513'). Required for 'create', optional for 'update'. Validated by the legacy handler to preserve its error behavior."
      },
      "description": {
        "anyOf": [
          {
            "description": "Label description text. Optional for 'create' and 'update'.",
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Label description text. Optional for 'create' and 'update'. Validated by the legacy handler to preserve its error behavior."
      },
      "method": {
        "anyOf": [
          {
            "description": "Operation to perform: 'create', 'update', or 'delete'",
            "enum": [
              "create",
              "update",
              "delete"
            ],
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Operation to perform: 'create', 'update', or 'delete' Required by the legacy handler. Validated by the legacy handler to preserve its error behavior."
      },
      "name": {
        "anyOf": [
          {
            "description": "Label name - required for all operations",
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Label name - required for all operations Required by the legacy handler. Validated by the legacy handler to preserve its error behavior."
      },
      "new_name": {
        "anyOf": [
          {
            "description": "New name for the label (used only with 'update' method to rename)",
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "New name for the label (used only with 'update' method to rename) Validated by the legacy handler to preserve its error behavior."
      },
      "owner": {
        "description": "Repository owner (username or organization name)",
        "type": "string",
        "x-mcp-header": "owner"
      },
      "repo": {
        "description": "Repository name",
        "type": "string",
        "x-mcp-header": "repo"
      }
    },
    "type": "object"
  },
  "name": "label_write",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "message": {
        "type": "string"
      }
    },
    "required": [
      "message"
    ],
    "type": "object"
  }
}