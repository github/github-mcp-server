        "description": "The pull request number",
        "minimum": 1,
        "type": "number"
      },
      "reaction_id": {
        "description": "The reaction ID to remove",
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
