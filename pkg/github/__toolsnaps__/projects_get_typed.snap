{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "Get details of GitHub Projects resources"
  },
  "description": "Get details about specific GitHub Projects resources.\nUse this tool to get details about individual projects, project fields, project items, and project views by their unique IDs.\n",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "properties": {
      "field_id": {
        "anyOf": [
          {
            "description": "The field's ID. Required for 'get_project_field' method.",
            "type": "number"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "The field's ID. Required for 'get_project_field' method. Validated by the selected method; otherwise ignored."
      },
      "field_names": {
        "anyOf": [
          {
            "description": "Specific list of field names to include in the response when getting a project item (e.g. [\"Status\", \"Priority\"]). Resolved server-side to field IDs — pass this instead of 'fields' when you only know the human-readable names. Mutually exclusive with 'fields' — provide one, not both. Only used for 'get_project_item' method.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "Specific list of field names to include in the response when getting a project item (e.g. [\"Status\", \"Priority\"]). Resolved server-side to field IDs — pass this instead of 'fields' when you only know the human-readable names. Mutually exclusive with 'fields' — provide one, not both. Only used for 'get_project_item' method. Validated by the selected method; otherwise ignored."
      },
      "fields": {
        "anyOf": [
          {
            "description": "Specific list of field IDs to include in the response when getting a project item (e.g. [\"102589\", \"985201\", \"169875\"]). If neither 'fields' nor 'field_names' is provided, only the title field is included. Mutually exclusive with 'field_names' — provide one, not both. Only used for 'get_project_item' method.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "Specific list of field IDs to include in the response when getting a project item (e.g. [\"102589\", \"985201\", \"169875\"]). If neither 'fields' nor 'field_names' is provided, only the title field is included. Mutually exclusive with 'field_names' — provide one, not both. Only used for 'get_project_item' method. Validated by the selected method; otherwise ignored."
      },
      "item_id": {
        "anyOf": [
          {
            "description": "The item's ID. Required for 'get_project_item' method.",
            "type": "number"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "The item's ID. Required for 'get_project_item' method. Validated by the selected method; otherwise ignored."
      },
      "method": {
        "anyOf": [
          {
            "description": "The method to execute",
            "enum": [
              "get_project",
              "get_project_field",
              "get_project_item",
              "get_project_status_update",
              "get_project_view"
            ],
            "type": "string"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "The method to execute Validated by the selected method; otherwise ignored."
      },
      "owner": {
        "description": "The owner (user or organization login). The name is not case sensitive.",
        "type": "string",
        "x-mcp-header": "owner"
      },
      "owner_type": {
        "anyOf": [
          {
            "description": "Owner type (user or org). If not provided, will be automatically detected.",
            "enum": [
              "user",
              "org"
            ],
            "type": "string"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "Owner type (user or org). If not provided, will be automatically detected. Validated by the selected method; otherwise ignored."
      },
      "project_number": {
        "anyOf": [
          {
            "description": "The project's number.",
            "type": "number"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "The project's number. Validated by the selected method; otherwise ignored."
      },
      "status_update_id": {
        "anyOf": [
          {
            "description": "The node ID of the project status update. Required for 'get_project_status_update' method.",
            "type": "string"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "The node ID of the project status update. Required for 'get_project_status_update' method. Validated by the selected method; otherwise ignored."
      },
      "view_id": {
        "anyOf": [
          {
            "description": "The node ID of the project view. Required for 'get_project_view' method.",
            "type": "string"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "The node ID of the project view. Required for 'get_project_view' method. Validated by the selected method; otherwise ignored."
      }
    },
    "type": "object"
  },
