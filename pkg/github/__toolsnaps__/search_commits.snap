          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "total_count": {
        "type": "integer"
      }
    },
    "required": [
      "total_count",
      "incomplete_results",
      "items"
    ],
    "type": [
      "null",
      "object"
    ]
  }
