{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "Read issue artifacts"
  },
  "description": "List or get GitHub issue artifacts including their bodies. Get requires artifact_number (issue-scoped, not its global ID). List accepts an optional type filter and page/perPage; request successive pages until a page contains fewer than perPage artifacts.",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "artifact_number": {
        "description": "Required for get: positive issue-scoped artifact number, not its global ID",
        "minimum": 1,
        "type": "integer"
      },
      "issue_number": {
        "description": "Positive issue number",
        "minimum": 1,
        "type": "integer"
      },
      "method": {
        "enum": [
          "list",
          "get"
        ],
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "minLength": 1,
        "type": "string",
        "x-mcp-header": "owner"
      },
      "page": {
        "description": "For list only: page number, starting at 1 (default 1)",
        "minimum": 1,
        "type": "integer"
      },
      "perPage": {
        "description": "For list only: results per page, from 1 to 100 (default 30)",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name",
        "minLength": 1,
        "type": "string",
        "x-mcp-header": "repo"
      },
      "type": {
        "enum": [
          "generic",
          "link",
          "plan",
          "embedded_html"
        ],
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "issue_number",
      "method"
    ],
    "type": "object"
  },
  "name": "issue_artifact_read",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "artifact": {
        "additionalProperties": false,
        "description": "Artifact returned by get",
        "properties": {
          "body": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "type",
          "name",
          "body"
        ],
        "type": [
          "null",
          "object"
        ]
      },
      "list": {
        "additionalProperties": false,
        "description": "Page of artifacts returned by list",
        "properties": {
          "artifacts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "body": {
                  "type": "string"
                },
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "number": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "number",
                "type",
                "name",
                "body"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "page": {
            "type": "integer"
          },
          "perPage": {
            "type": "integer"
          }
        },
        "required": [
          "artifacts",
          "page",
          "perPage"
        ],
        "type": [
          "null",
          "object"
        ]
      }
    },
    "type": [
      "null",
      "object"
    ]
  }
}