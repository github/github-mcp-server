{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "List repository automations"
  },
  "description": "List Copilot automations for a repository.",
  "inputSchema": {
    "properties": {
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "description": "Page number, starting at 1.",
        "minimum": 1,
        "type": "integer"
      },
      "perPage": {
        "description": "Results per page, from 1 to 100.",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "type": {
        "description": "Filter automations by type.",
        "enum": [
          "personal",
          "shared"
        ],
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_automations",
  "outputSchema": {
    "additionalProperties": true,
    "type": "object"
  }
}