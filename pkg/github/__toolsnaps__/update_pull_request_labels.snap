{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false,
    "title": "Update Pull Request Labels"
  },
  "description": "Update the labels of an existing pull request. This replaces the current labels with the provided list.",
  "inputSchema": {
    "properties": {
      "labels": {
        "description": "Labels to apply to this pull request",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "owner": {
        "description": "Repository owner (username or organization)",
        "type": "string"
      },
      "pullNumber": {
        "description": "The pull request number",
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "pullNumber",
      "labels"
    ],
    "type": "object"
  },
  "name": "update_pull_request_labels"
}