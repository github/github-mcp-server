{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "Read repository rulesets"
  },
  "description": "Read rulesets at the repository, organization, or enterprise level, and rule suites at the repository or organization level. Select the level with the 'level' parameter and the operation with the 'method' parameter.",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "additionalProperties": true,
    "properties": {
      "actor_name": {
        "anyOf": [
          {
            "description": "The handle for the GitHub user account to filter rule suites on. Used by the 'list_rule_suites' method.",
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "The handle for the GitHub user account to filter rule suites on. Used by the 'list_rule_suites' method. Validated by the legacy handler to preserve its error behavior."
      },
      "branch": {
        "anyOf": [
          {
            "description": "Branch name. Required for the 'get_rules_for_branch' method.",
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Branch name. Required for the 'get_rules_for_branch' method. Validated by the legacy handler to preserve its error behavior."
      },
      "enterprise": {
        "anyOf": [
          {
            "description": "Enterprise slug. Required when level is 'enterprise'.",
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Enterprise slug. Required when level is 'enterprise'. Validated by the legacy handler to preserve its error behavior."
      },
      "evaluate_status": {
        "anyOf": [
          {
            "description": "Filter rule suites by ruleset evaluation mode. Used by the 'list_rule_suites' method.",
            "enum": [
              "all",
              "active",
              "evaluate"
            ],
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Filter rule suites by ruleset evaluation mode. Used by the 'list_rule_suites' method. Validated by the legacy handler to preserve its error behavior."
      },
      "includes_parents": {
        "anyOf": [
          {
            "description": "Include rulesets configured at higher levels that also apply. Defaults to true. Used by the 'get' and 'list' methods at the repository level.",
            "type": "boolean"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Include rulesets configured at higher levels that also apply. Defaults to true. Used by the 'get' and 'list' methods at the repository level. Validated by the legacy handler to preserve its error behavior."
      },
      "level": {
        "anyOf": [
          {
            "description": "The level at which the ruleset is configured:\n- 'repository': A ruleset on a single repository (requires 'owner' and 'repo').\n- 'organization': A ruleset covering repositories in an organization (requires 'org').\n- 'enterprise': A ruleset covering repositories across an enterprise (requires 'enterprise').",
            "enum": [
              "repository",
              "organization",
              "enterprise"
            ],
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "The level at which the ruleset is configured:\n- 'repository': A ruleset on a single repository (requires 'owner' and 'repo').\n- 'organization': A ruleset covering repositories in an organization (requires 'org').\n- 'enterprise': A ruleset covering repositories across an enterprise (requires 'enterprise'). Required by the legacy handler. Validated by the legacy handler to preserve its error behavior."
      },
      "method": {
        "anyOf": [
          {
            "description": "Operation to perform:\n- 'get': Get a specific ruleset by ID (requires 'ruleset_id'). Supported at every level.\n- 'list': List all rulesets. Supported at every level.\n- 'get_rules_for_branch': Get all rules that apply to a branch (requires 'branch'). Repository level only.\n- 'list_rule_suites': List rule suites, the evaluations of rules against pushes. Repository and organization levels only.\n- 'get_rule_suite': Get a specific rule suite by ID (requires 'rule_suite_id'). Repository and organization levels only.",
            "enum": [
              "get",
              "list",
              "get_rules_for_branch",
              "list_rule_suites",
              "get_rule_suite"
            ],
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Operation to perform:\n- 'get': Get a specific ruleset by ID (requires 'ruleset_id'). Supported at every level.\n- 'list': List all rulesets. Supported at every level.\n- 'get_rules_for_branch': Get all rules that apply to a branch (requires 'branch'). Repository level only.\n- 'list_rule_suites': List rule suites, the evaluations of rules against pushes. Repository and organization levels only.\n- 'get_rule_suite': Get a specific rule suite by ID (requires 'rule_suite_id'). Repository and organization levels only. Required by the legacy handler. Validated by the legacy handler to preserve its error behavior."
      },
      "org": {
        "anyOf": [
          {
            "description": "Organization name. Required when level is 'organization'.",
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Organization name. Required when level is 'organization'. Validated by the legacy handler to preserve its error behavior."
      },
      "owner": {
        "description": "Repository owner. Required when level is 'repository'.",
        "type": "string",
        "x-mcp-header": "owner"
      },
      "page": {
        "anyOf": [
          {
            "description": "Page number for pagination (min 1)",
            "minimum": 1,
            "type": "number"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Page number for pagination (min 1) Validated by the legacy handler to preserve its error behavior."
      },
      "perPage": {
        "anyOf": [
          {
            "description": "Results per page for pagination (min 1, max 100)",
            "maximum": 100,
            "minimum": 1,
            "type": "number"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Results per page for pagination (min 1, max 100) Validated by the legacy handler to preserve its error behavior."
      },
      "ref": {
        "anyOf": [
          {
            "description": "The name of the ref (branch, tag, etc.) to filter rule suites by. Used by the 'list_rule_suites' method.",
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "The name of the ref (branch, tag, etc.) to filter rule suites by. Used by the 'list_rule_suites' method. Validated by the legacy handler to preserve its error behavior."
      },
      "repo": {
        "description": "Repository name. Required when level is 'repository'.",
        "type": "string",
        "x-mcp-header": "repo"
      },
      "repository_name": {
        "anyOf": [
          {
            "description": "Repository name to filter rule suites by. Used by the 'list_rule_suites' method at the organization level.",
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Repository name to filter rule suites by. Used by the 'list_rule_suites' method at the organization level. Validated by the legacy handler to preserve its error behavior."
      },
      "rule_suite_id": {
        "anyOf": [
          {
            "description": "Rule suite ID. Required for the 'get_rule_suite' method.",
            "type": "number"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Rule suite ID. Required for the 'get_rule_suite' method. Validated by the legacy handler to preserve its error behavior."
      },
      "rule_suite_result": {
        "anyOf": [
          {
            "description": "The rule suite result to filter by. Used by the 'list_rule_suites' method.",
            "enum": [
              "pass",
              "fail",
              "bypass",
              "all"
            ],
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "The rule suite result to filter by. Used by the 'list_rule_suites' method. Validated by the legacy handler to preserve its error behavior."
      },
      "ruleset_id": {
        "anyOf": [
          {
            "description": "Ruleset ID. Required for the 'get' method.",
            "type": "number"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "Ruleset ID. Required for the 'get' method. Validated by the legacy handler to preserve its error behavior."
      },
      "time_period": {
        "anyOf": [
          {
            "description": "The time period to filter rule suites by. Used by the 'list_rule_suites' method.",
            "enum": [
              "hour",
              "day",
              "week",
              "month"
            ],
            "type": "string"
          },
          {
            "description": "Other JSON values are validated by the legacy handler."
          }
        ],
        "description": "The time period to filter rule suites by. Used by the 'list_rule_suites' method. Validated by the legacy handler to preserve its error behavior."
      }
    },
    "type": "object"
  },
