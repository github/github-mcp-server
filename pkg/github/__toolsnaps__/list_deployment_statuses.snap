{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "List deployment statuses"
  },
  "description": "List the statuses of a deployment in a GitHub repository, newest first. The first status is the deployment's current state (e.g. success, failure, error, in_progress, queued, pending or inactive).",
  "inputSchema": {
    "properties": {
      "deployment_id": {
        "description": "The deployment ID, as returned by list_deployments",
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "description": "Page number for pagination (min 1)",
        "minimum": 1,
        "type": "number"
      },
      "perPage": {
        "description": "Results per page for pagination (min 1, max 100)",
        "maximum": 100,
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "deployment_id"
    ],
    "type": "object"
  },
  "name": "list_deployment_statuses"
}