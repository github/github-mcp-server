            "description": "Results per page (max 50)",
            "type": "number"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "Results per page (max 50) Validated by the selected method; otherwise ignored."
      },
      "project_number": {
        "anyOf": [
          {
            "description": "The project's number. Required for 'list_project_fields', 'list_project_items', 'list_project_views', and 'list_project_status_updates' methods.",
            "type": "number"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "The project's number. Required for 'list_project_fields', 'list_project_items', 'list_project_views', and 'list_project_status_updates' methods. Validated by the selected method; otherwise ignored."
      },
      "query": {
        "anyOf": [
          {
            "description": "Filter/query string. For list_projects: filter by title text and state (e.g. \"roadmap is:open\"). For list_project_items: advanced filtering using GitHub's project filtering syntax.",
            "type": "string"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "Filter/query string. For list_projects: filter by title text and state (e.g. \"roadmap is:open\"). For list_project_items: advanced filtering using GitHub's project filtering syntax. Validated by the selected method; otherwise ignored."
