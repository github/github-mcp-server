{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "List GitHub Projects resources"
  },
  "description": "Tools for listing GitHub Projects resources.\nUse this tool to list projects for a user or organization, or list project fields, items, views, and status updates for a specific project.\n",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "properties": {
      "after": {
        "anyOf": [
          {
            "description": "Forward pagination cursor from previous pageInfo.nextCursor.",
            "type": "string"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "Forward pagination cursor from previous pageInfo.nextCursor. Validated by the selected method; otherwise ignored."
      },
      "before": {
        "anyOf": [
          {
            "description": "Backward pagination cursor from previous pageInfo.prevCursor (rare).",
            "type": "string"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "Backward pagination cursor from previous pageInfo.prevCursor (rare). Validated by the selected method; otherwise ignored."
      },
      "field_names": {
        "anyOf": [
          {
            "description": "Field names to include when listing project items (e.g. [\"Status\", \"Priority\"]). Resolved server-side to field IDs — pass this instead of 'fields' when you only know the human-readable names. Names that fail to resolve return a structured error. Mutually exclusive with 'fields' — provide one, not both. Only used for 'list_project_items' method.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "Field names to include when listing project items (e.g. [\"Status\", \"Priority\"]). Resolved server-side to field IDs — pass this instead of 'fields' when you only know the human-readable names. Names that fail to resolve return a structured error. Mutually exclusive with 'fields' — provide one, not both. Only used for 'list_project_items' method. Validated by the selected method; otherwise ignored."
      },
      "fields": {
        "anyOf": [
          {
            "description": "Field IDs to include when listing project items (e.g. [\"102589\", \"985201\"]). CRITICAL: Always provide to get field values. Without this (and without 'field_names'), only titles returned. Mutually exclusive with 'field_names' — provide one, not both. Only used for 'list_project_items' method.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "Field IDs to include when listing project items (e.g. [\"102589\", \"985201\"]). CRITICAL: Always provide to get field values. Without this (and without 'field_names'), only titles returned. Mutually exclusive with 'field_names' — provide one, not both. Only used for 'list_project_items' method. Validated by the selected method; otherwise ignored."
      },
      "method": {
        "anyOf": [
          {
            "description": "The action to perform",
            "enum": [
              "list_projects",
              "list_project_fields",
              "list_project_items",
              "list_project_status_updates",
              "list_project_views"
            ],
            "type": "string"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
        ],
        "description": "The action to perform Validated by the selected method; otherwise ignored."
      },
      "owner": {
        "description": "The owner (user or organization login). The name is not case sensitive.",
        "type": "string",
        "x-mcp-header": "owner"
      },
      "owner_type": {
        "anyOf": [
          {
            "description": "Owner type (user or org). If not provided, will automatically try both.",
            "enum": [
              "user",
              "org"
            ],
            "type": "string"
          },
          {
            "description": "Other JSON values are handled by the method-specific validator, preserving its errors and validation order."
          }
