{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false,
    "title": "Enable pull request auto-merge"
  },
  "description": "Enable auto-merge on a pull request, so it merges automatically once all required reviews and status checks pass. Requires write access to the repository. Auto-merge can only be enabled when the repository allows it, and disabling requires the pull request to have auto-merge enabled.",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "properties": {
      "commit_message": {
        "description": "Extra detail (body) for the merge commit. If omitted, a default message will be used. Ignored when the pull request enters a merge queue.",
        "type": "string"
      },
      "commit_title": {
        "description": "Title (headline) for the merge commit. If omitted, a default message will be used. Ignored when the pull request enters a merge queue.",
        "type": "string"
      },
      "merge_method": {
        "description": "Merge method to use when the pull request becomes mergeable. If omitted, defaults to merge. Ignored when the pull request enters a merge queue.",
        "enum": [
          "merge",
          "squash",
          "rebase"
        ],
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "pullNumber": {
        "description": "Pull request number",
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "pullNumber"
    ],
    "type": "object"
  },
  "name": "enable_pull_request_auto_merge",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "auto_merge_enabled": {
        "type": "boolean"
      },
      "merge_method": {
        "description": "The merge method auto-merge will use, in GitHub's lowercase form (merge, squash, or rebase); omitted when auto-merge is disabled or no method was reported.",
        "type": "string"
      },
      "node_id": {
        "type": "string"
      }
    },
    "required": [
      "node_id",
      "auto_merge_enabled"
    ],
    "type": "object"
  }
}