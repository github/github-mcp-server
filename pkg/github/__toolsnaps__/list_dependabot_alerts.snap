{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "List dependabot alerts"
  },
  "description": "List dependabot alerts in a GitHub repository.",
  "inputSchema": {
    "properties": {
      "after": {
        "description": "Cursor for pagination. Use the cursor from the previous response.",
        "type": "string"
      },
      "owner": {
        "description": "The owner of the repository.",
        "type": "string"
      },
      "perPage": {
        "description": "Results per page for pagination (min 1, max 100)",
        "maximum": 100,
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "The name of the repository.",
        "type": "string"
      },
      "severity": {
        "description": "Filter dependabot alerts by severity",
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "type": "string"
      },
      "state": {
        "default": "open",
        "description": "Filter dependabot alerts by state. Defaults to open",
        "enum": [
          "open",
          "fixed",
          "dismissed",
          "auto_dismissed"
        ],
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_dependabot_alerts",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "alerts": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "dependency": {
              "additionalProperties": false,
              "properties": {
                "manifest_path": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "package": {
                  "additionalProperties": false,
                  "properties": {
                    "ecosystem": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "name": {
                      "type": [
                        "null",
                        "string"
                      ]
                    }
                  },
                  "type": [
                    "null",
                    "object"
                  ]
                },
                "scope": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "type": [
                "null",
                "object"
              ]
            },
            "dismissed_comment": {
              "type": [
                "null",
                "string"
              ]
            },
            "dismissed_reason": {
              "type": [
                "null",
                "string"
              ]
            },
            "html_url": {
              "type": [
                "null",
                "string"
              ]
            },
            "number": {
              "type": [
                "null",
                "integer"
              ]
            },
            "security_advisory": {
              "additionalProperties": false,
              "properties": {
                "classification": {
                  "description": "GitHub advisory classification, such as malware or general.",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "cve_id": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "description": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "ghsa_id": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "severity": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "summary": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "type": [
                "null",
                "object"
              ]
            },
            "security_vulnerability": {
              "additionalProperties": false,
              "properties": {
                "first_patched_version": {
                  "description": "Earliest version fixing the affected package.",
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "package": {
                  "additionalProperties": false,
                  "properties": {
                    "ecosystem": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "name": {
                      "type": [
                        "null",
                        "string"
                      ]
                    }
                  },
                  "type": [
                    "null",
                    "object"
                  ]
                },
                "severity": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "vulnerable_version_range": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "type": [
                "null",
                "object"
              ]
            },
            "state": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "type": [
            "null",
            "object"
          ]
        },
        "type": [
          "null",
          "array"
        ]
      },
      "pageInfo": {
        "additionalProperties": false,
        "properties": {
          "hasNextPage": {
            "type": "boolean"
          },
          "hasPreviousPage": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": "string"
          },
          "prevCursor": {
            "type": "string"
          }
        },
        "required": [
          "hasNextPage",
          "hasPreviousPage"
        ],
        "type": "object"
      }
    },
    "required": [
      "alerts",
      "pageInfo"
    ],
    "type": "object"
  }
}