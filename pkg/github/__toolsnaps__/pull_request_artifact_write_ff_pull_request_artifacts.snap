{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "readOnlyHint": false,
    "title": "Write pull request artifacts"
  },
  "description": "Upsert or delete a GitHub pull request artifact by name, not its number or global ID. Upsert requires body and optionally accepts commit_oid; creates a new artifact or replaces the named artifact's content. Delete does not accept body or commit_oid. Writes are not automatically retried. Repository access and the repository's pull_request_artifacts_api rollout are enforced by GitHub. Unavailable in lockdown mode.",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "body": {
        "description": "Required for upsert: artifact content; an empty string is sent unchanged. Not supported for delete",
        "type": "string"
      },
      "commit_oid": {
        "description": "Optional commit OID for upsert only; omission preserves the API default",
        "type": "string"
      },
      "method": {
        "enum": [
          "upsert",
          "delete"
        ],
        "type": "string"
      },
      "name": {
        "description": "Artifact name, not its number or global ID",
        "minLength": 1,
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "minLength": 1,
        "type": "string",
        "x-mcp-header": "owner"
      },
      "pull_number": {
        "description": "Positive pull request number",
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name",
        "minLength": 1,
        "type": "string",
        "x-mcp-header": "repo"
      }
    },
    "required": [
      "owner",
      "repo",
      "pull_number",
      "method",
      "name"
    ],
    "type": "object"
  },
  "name": "pull_request_artifact_write",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "artifact": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "string"
          },
          "commit_oid": {
            "type": [
              "null",
              "string"
            ]
          },
          "created_at": {
            "type": [
              "null",
              "string"
            ]
          },
          "creator": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer"
              },
              "login": {
                "type": "string"
              }
            },
            "required": [
              "login",
              "id"
            ],
            "type": [
              "null",
              "object"
            ]
          },
          "id": {
            "description": "Opaque artifact ID; mutations use name instead",
            "type": [
              "string",
              "integer"
            ]
          },
          "name": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "updated_at": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "id",
          "number",
          "name",
          "body",
          "commit_oid",
          "creator",
          "created_at",
          "updated_at"
        ],
        "type": [
          "null",
          "object"
        ]
      },
      "deleted": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "pull_number": {
            "type": "integer"
          }
        },
        "required": [
          "pull_number",
          "name",
          "message"
        ],
        "type": [
          "null",
          "object"
        ]
      }
    },
    "type": [
      "null",
      "object"
    ]
  }
}