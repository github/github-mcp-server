{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "Read pull request artifacts"
  },
  "description": "List GitHub pull request artifact versions including their bodies. commit_oid defaults to the current PR head; use all or an explicit commit OID to change the selection. Returns one page; request next_page when present. Repository access and the repository's pull_request_artifacts_api rollout are enforced by GitHub. Unavailable in lockdown mode.",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "commit_oid": {
        "description": "Commit selection: omitted or current for the current PR head, all for every commit, or an explicit commit OID",
        "type": "string"
      },
      "method": {
        "enum": [
          "list"
        ],
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "minLength": 1,
        "type": "string",
        "x-mcp-header": "owner"
      },
      "page": {
        "description": "Page number, starting at 1 (default 1)",
        "minimum": 1,
        "type": "integer"
      },
      "perPage": {
        "description": "Results per page, from 1 to 100 (default 30)",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "pull_number": {
        "description": "Positive pull request number",
        "minimum": 1,
        "type": "integer"
      },
      "repo": {
        "description": "Repository name",
        "minLength": 1,
        "type": "string",
        "x-mcp-header": "repo"
      }
    },
    "required": [
      "owner",
      "repo",
      "pull_number",
      "method"
    ],
    "type": "object"
  },
  "name": "pull_request_artifact_read",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "list": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "body": {
                  "type": "string"
                },
                "commit_oid": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "created_at": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "creator": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "login": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "login",
                    "id"
                  ],
                  "type": [
                    "null",
                    "object"
                  ]
                },
                "id": {
                  "description": "Opaque artifact ID; mutations use name instead",
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "number": {
                  "type": "integer"
                },
                "updated_at": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "required": [
                "id",
                "number",
                "name",
                "body",
                "commit_oid",
                "creator",
                "created_at",
                "updated_at"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "next_page": {
            "description": "Next page from the API Link header; absent when there is no next page",
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "perPage": {
            "type": "integer"
          }
        },
        "required": [
          "artifacts",
          "page",
          "perPage"
        ],
        "type": [
          "null",
          "object"
        ]
      }
    },
    "required": [
      "list"
    ],
    "type": [
      "null",
      "object"
    ]
  }
}