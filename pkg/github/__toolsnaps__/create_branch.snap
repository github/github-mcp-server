{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": false,
    "title": "Create branch"
  },
  "description": "Create a new branch in a GitHub repository",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "properties": {
      "branch": {
        "description": "Name for new branch",
        "type": "string"
      },
      "from_branch": {
        "description": "Source branch (defaults to repo default)",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string",
        "x-mcp-header": "owner"
      },
      "repo": {
        "description": "Repository name",
        "type": "string",
        "x-mcp-header": "repo"
      }
    },
    "required": [
      "owner",
      "repo",
      "branch"
    ],
    "type": "object"
  },
  "name": "create_branch",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "object": {
        "additionalProperties": false,
        "properties": {
          "sha": {
            "type": "string"
          },
          "type": {
            "description": "Git object kind: commit, tag, tree, or blob.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "sha"
        ],
        "type": "object"
      },
      "ref": {
        "description": "Fully qualified reference, such as refs/heads/main.",
        "type": "string"
      }
    },
    "required": [
      "ref",
      "object"
    ],
    "type": [
      "null",
      "object"
    ]
  }
}