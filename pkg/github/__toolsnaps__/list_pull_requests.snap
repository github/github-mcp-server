          ]
        },
        "head": {
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string"
            },
            "repo": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "full_name": {
                  "type": "string"
                }
              },
              "required": [
                "full_name"
              ],
              "type": [
                "null",
