{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "Get discussion"
  },
  "description": "Get a specific discussion by ID",
  "inputSchema": {
    "properties": {
      "discussionNumber": {
        "description": "Discussion Number",
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "discussionNumber"
    ],
    "type": "object"
  },
  "name": "get_discussion",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "answerChosenAt": {
        "description": "Answer selection time (RFC3339), when selected.",
        "type": [
          "null",
          "string"
        ]
      },
      "body": {
        "type": "string"
      },
      "category": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "closed": {
        "type": "boolean"
      },
      "createdAt": {
        "description": "Creation time (RFC3339).",
        "type": "string"
      },
      "html_url": {
        "type": "string"
      },
      "isAnswered": {
        "type": "boolean"
      },
      "number": {
        "type": "integer"
      },
      "title": {
        "type": "string"
      }
    },
    "required": [
      "number",
      "title",
      "body",
      "html_url",
      "closed",
      "isAnswered",
      "createdAt",
      "category"
    ],
    "type": "object"
  }
}