{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "List automation tags"
  },
  "description": "List caller-visible automation tags in a repository. Tags organize automations; they do not execute them. Use nextPage with the same perPage to continue. Pages are not a snapshot across concurrent changes.",
  "inputSchema": {
    "properties": {
      "owner": {
        "description": "Repository owner",
        "minLength": 1,
        "type": "string"
      },
      "page": {
        "description": "Page number for pagination (min 1)",
        "minimum": 1,
        "type": "number"
      },
      "perPage": {
        "description": "Results per page for pagination (min 1, max 100)",
        "maximum": 100,
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_automation_tags"
}