{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false,
    "title": "Update Issue Status"
  },
  "description": "Update an issue's planning status. Done, Not planned and Duplicate close the issue; the other statuses keep it open or reopen it. Closing statuses require confirm_close: true, set only after the user confirms closing the issue. Duplicate requires duplicate_of, the canonical issue number in the same repository. A status cannot be removed.",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "properties": {
      "confirm_close": {
        "description": "Must be true for Done, Not planned or Duplicate. Set only after the user confirms closing the issue.",
        "type": "boolean"
      },
      "duplicate_of": {
        "description": "The canonical issue number. Required only for Duplicate.",
        "minimum": 1,
        "type": "number"
      },
      "issue_number": {
        "description": "The issue number to update",
        "minimum": 1,
        "type": "number"
      },
      "owner": {
        "description": "Repository owner (username or organization)",
        "type": "string",
        "x-mcp-header": "owner"
      },
      "repo": {
        "description": "Repository name",
        "type": "string",
        "x-mcp-header": "repo"
      },
      "status": {
        "description": "The planning status to assign.",
        "enum": [
          "Backlog",
          "Todo",
          "In progress",
          "In review",
          "Done",
          "Not planned",
          "Duplicate"
        ],
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "issue_number",
      "status"
    ],
    "type": "object"
  },
  "name": "update_issue_status",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string"
      },
      "status": {
        "additionalProperties": false,
        "description": "The issue's planning status, or null when it has none or it is not recognized. Backlog is backlog; Todo is planned; In progress and In review are started; Done is completed; Not planned is not_planned; Duplicate is duplicate.",
        "properties": {
          "category": {
            "enum": [
              "backlog",
              "planned",
              "started",
              "completed",
              "not_planned",
              "duplicate"
            ],
            "type": "string"
          },
          "id": {
            "description": "The status ID.",
            "type": "integer"
          },
          "name": {
            "enum": [
              "Backlog",
              "Todo",
              "In progress",
              "In review",
              "Done",
              "Not planned",
              "Duplicate"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "category"
        ],
        "type": [
          "object",
          "null"
        ]
      },
      "url": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "url",
      "status"
    ],
    "type": "object"
  }
}