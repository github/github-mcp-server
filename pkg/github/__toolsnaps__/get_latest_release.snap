      },
      "repo": {
        "description": "Repository name",
        "type": "string",
        "x-mcp-header": "repo"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "get_latest_release",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "author": {
        "additionalProperties": false,
        "properties": {
          "avatar_url": {
            "type": "string"
          },
          "details": {
            "additionalProperties": false,
            "properties": {
              "bio": {
