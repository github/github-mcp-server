{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "Get latest release"
  },
  "description": "Get the latest release in a GitHub repository",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "properties": {
      "owner": {
        "description": "Repository owner",
        "type": "string",
