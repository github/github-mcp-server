                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "followers": {
                "type": "integer"
              },
              "following": {
                "type": "integer"
              },
              "hireable": {
                "type": "boolean"
              },
              "location": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "owned_private_repos": {
                "type": "integer"
              },
              "private_gists": {
                "type": "integer"
              },
              "public_gists": {
                "type": "integer"
              },
              "public_repos": {
                "type": "integer"
              },
              "total_private_repos": {
                "type": "integer"
              },
              "twitter_username": {
                "type": "string"
              },
              "updated_at": {
                "description": "Last profile update time in RFC3339 format.",
                "type": "string"
              }
            },
            "required": [
              "public_repos",
              "public_gists",
              "followers",
              "following",
              "created_at",
              "updated_at"
            ],
            "type": [
              "null",
              "object"
            ]
          },
          "id": {
            "type": "integer"
          },
          "login": {
            "type": "string"
          },
          "profile_url": {
            "type": "string"
          }
        },
        "required": [
          "login"
        ],
        "type": [
          "null",
          "object"
        ]
      },
      "body": {
        "type": "string"
      },
      "draft": {
        "description": "Whether the release is unpublished.",
        "type": "boolean"
      },
      "html_url": {
        "type": "string"
      },
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "prerelease": {
