{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false,
    "title": "Update secret scanning alert"
  },
  "description": "Update a secret scanning alert's state, assignee, or validity override. Provide at least one of state, assignee, or validity. Resolving requires a non-null resolution. Omitted fields are unchanged; null unassigns the assignee or clears the validity override. Resolution comments accompany closing or reopening and cannot later be edited or deleted. Resolution revoked does not revoke credentials; validity is a manual override for custom-pattern alerts only, not a validation request. GitHub-supported patterns retain validator-managed validity and cannot be overridden through this endpoint. Requires repository secret scanning write access. Delegated dismissal may require Secret scanning alert dismissal requests write permission and an authorized reviewer; API policy failures are returned without bypass.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "alertNumber": {
        "description": "Secret scanning alert number.",
        "minimum": 1,
        "type": "integer"
      },
      "assignee": {
        "description": "Username with repository write access; null unassigns.",
        "type": [
          "string",
          "null"
        ]
      },
      "owner": {
        "description": "Repository owner.",
        "minLength": 1,
        "type": "string"
      },
      "repo": {
        "description": "Repository name.",
        "minLength": 1,
        "type": "string"
      },
      "resolution": {
        "description": "Reason for resolving. Non-null when state is resolved.",
        "enum": [
          "false_positive",
          "wont_fix",
          "revoked",
          "used_in_tests",
          null
        ],
        "type": [
          "string",
          "null"
        ]
      },
      "resolution_comment": {
        "description": "Optional comment when closing or reopening; cannot later be updated or deleted.",
        "type": [
          "string",
          "null"
        ]
      },
      "state": {
        "description": "Reopen or resolve the alert.",
        "enum": [
          "open",
          "resolved"
        ],
        "type": "string"
      },
      "validity": {
        "description": "Manual validity override for custom-pattern alerts only; null clears the override. GitHub-supported patterns retain validator-managed validity.",
        "enum": [
          "active",
          "inactive",
          null
        ],
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "owner",
      "repo",
      "alertNumber"
    ],
    "type": "object"
  },
  "name": "update_secret_scanning_alert",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "assigned_to": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "type": "string"
          }
        },
        "required": [
          "login"
        ],
        "type": [
          "null",
          "object"
        ]
      },
      "number": {
        "description": "Exact alert number as a decimal string to preserve integer precision.",
        "type": "string"
      },
      "resolution": {
        "type": [
          "null",
          "string"
        ]
      },
      "state": {
        "type": "string"
      },
      "validity": {
        "type": [
          "null",
          "string"
        ]
      }
    },
    "required": [
      "number",
      "state",
      "resolution",
      "assigned_to"
    ],
    "type": [
      "null",
      "object"
    ]
  }
}