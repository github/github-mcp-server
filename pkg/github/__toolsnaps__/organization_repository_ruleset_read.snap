        "enum": [
          "get",
          "list"
        ],
        "type": "string"
      },
      "org": {
        "description": "Organization name",
        "type": "string"
      },
      "page": {
        "description": "Page number for pagination (min 1)",
        "minimum": 1,
        "type": "number"
      },
      "perPage": {
        "description": "Results per page for pagination (min 1, max 100)",
        "maximum": 100,
        "minimum": 1,
        "type": "number"
      },
      "ruleset_id": {
        "description": "Ruleset ID. Required for the 'get' method.",
        "type": "number"
      }
    },
    "required": [
