{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": false,
    "title": "Add pull request to merge queue"
  },
  "description": "Add a pull request to the merge queue of its base branch. Use this instead of merge_pull_request when the base branch requires a merge queue (see the get_merge_queue_status method of pull_request_read); the queue merges the pull request once its checks pass. Returns the merge queue entry.",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "properties": {
      "expectedHeadSha": {
        "description": "The expected SHA of the pull request's HEAD ref. The pull request is only queued if its head still matches.",
        "type": "string"
      },
      "jump": {
        "description": "Add the pull request to the front of the queue instead of the back",
        "type": "boolean"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "pullNumber": {
        "description": "Pull request number",
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "pullNumber"
    ],
    "type": "object"
  },
  "name": "enqueue_pull_request",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "enqueued_at": {
        "description": "RFC 3339 timestamp.",
        "type": "string"
      },
      "estimated_time_to_merge": {
        "description": "Estimated number of seconds until the pull request is merged.",
        "type": [
          "null",
          "integer"
        ]
      },
      "id": {
        "type": "string"
      },
      "jump": {
        "description": "Whether the entry was added to the front of the queue.",
        "type": "boolean"
      },
      "position": {
        "description": "One-based position in the merge queue.",
        "type": "integer"
      },
      "solo": {
        "description": "Whether the entry is merged on its own rather than grouped with other entries.",
        "type": "boolean"
      },
      "state": {
        "description": "Merge queue entry state.",
        "enum": [
          "QUEUED",
          "AWAITING_CHECKS",
          "MERGEABLE",
          "UNMERGEABLE",
          "LOCKED"
        ],
        "type": "string"
      }
    },
    "required": [
      "id",
      "position",
      "state",
      "enqueued_at",
      "jump",
      "solo"
    ],
    "type": [
      "object",
      "null"
    ]
  }
}