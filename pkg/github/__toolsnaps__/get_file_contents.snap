{
  "annotations": {
    "idempotentHint": false,
    "readOnlyHint": true,
    "title": "Get file or directory contents"
  },
  "description": "Get the contents of a file or directory from a GitHub repository",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "properties": {
      "fields": {
        "description": "Subset of fields to return for each entry when the path is a directory. If omitted, all fields are returned. Ignored when the path is a single file. Use this to reduce response size when listing directories and you only need specific fields, e.g. just 'name' and 'type'.",
        "items": {
          "enum": [
            "type",
            "name",
            "path",
            "size",
            "sha",
            "url",
            "git_url",
            "html_url",
            "download_url"
          ],
          "type": "string"
        },
        "type": "array"
      },
      "owner": {
        "description": "Repository owner (username or organization)",
        "type": "string",
        "x-mcp-header": "owner"
      },
      "path": {
        "default": "/",
        "description": "Path to file/directory",
        "type": "string"
      },
      "ref": {
        "description": "Accepts optional git refs such as `refs/tags/{tag}`, `refs/heads/{branch}` or `refs/pull/{pr_number}/head`",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string",
        "x-mcp-header": "repo"
      },
      "sha": {
        "description": "Accepts optional commit SHA. If specified, it will be used instead of ref",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "get_file_contents",
  "outputSchema": {
    "oneOf": [
      {
        "type": "null"
      },
      {
        "items": {
          "additionalProperties": false,
          "properties": {
            "download_url": {
              "type": [
                "null",
                "string"
              ]
            },
            "git_url": {
              "type": [
                "null",
                "string"
              ]
            },
            "html_url": {
              "type": [
                "null",
                "string"
              ]
            },
            "name": {
              "type": [
                "null",
                "string"
              ]
            },
            "path": {
              "type": [
                "null",
                "string"
              ]
            },
            "sha": {
              "type": [
                "null",
                "string"
              ]
            },
            "size": {
              "description": "File size in bytes.",
              "type": [
                "null",
                "integer"
              ]
            },
            "submodule_git_url": {
              "description": "Git remote URL for a submodule.",
              "type": [
                "null",
                "string"
              ]
            },
            "target": {
              "type": [
                "null",
                "string"
              ]
            },
            "type": {
              "type": [
                "null",
                "string"
              ]
            },
            "url": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "type": [
            "null",
            "object"
          ]
        },
        "type": "array"
      },
      {
        "additionalProperties": false,
        "properties": {
          "content": {
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "type": {
                      "const": "text",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "resource": {
                      "additionalProperties": false,
                      "oneOf": [
                        {
                          "not": {
                            "required": [
                              "blob"
                            ]
                          },
                          "required": [
                            "text"
                          ]
                        },
                        {
                          "not": {
                            "required": [
                              "text"
                            ]
                          },
                          "required": [
                            "blob"
                          ]
                        },
                        {
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "text"
                                ]
                              },
                              {
                                "required": [
                                  "blob"
                                ]
                              }
                            ]
                          }
                        }
                      ],
                      "properties": {
                        "blob": {
                          "description": "Base64-encoded file bytes.",
                          "type": [
                            "null",
                            "string"
                          ]
                        },
                        "mimeType": {
                          "type": "string"
                        },
                        "text": {
                          "type": [
                            "null",
                            "string"
                          ]
                        },
                        "uri": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "uri"
                      ],
                      "type": "object"
                    },
                    "type": {
                      "const": "resource",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "resource"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "size": {
                      "description": "File size in bytes.",
                      "type": [
                        "null",
                        "integer"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "type": {
                      "const": "resource_link",
                      "type": "string"
                    },
                    "uri": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "uri",
                    "name"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "array"
          }
        },
        "required": [
          "content"
        ],
        "type": "object"
      }
    ]
  }
}