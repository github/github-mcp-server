{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false,
    "title": "Hide Issue Comment"
  },
  "description": "Hide (minimize) a comment on an issue, or a conversation comment on a pull request. Requires triage or write access to the repository, or being its author.",
  "icons": [
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "light"
    },
    {
      "mimeType": "image/png",
      "src": "data:image/png;base64,",
      "theme": "dark"
    }
  ],
  "inputSchema": {
    "properties": {
      "classifier": {
        "description": "The reason for hiding the comment",
        "enum": [
          "SPAM",
          "ABUSE",
          "OFF_TOPIC",
          "OUTDATED",
          "DUPLICATE",
          "RESOLVED",
          "LOW_QUALITY"
        ],
        "type": "string"
      },
      "comment_id": {
        "description": "The numeric ID of the issue or pull request conversation comment",
        "minimum": 1,
        "type": "number"
      },
      "owner": {
        "description": "Repository owner (username or organization)",
        "type": "string",
        "x-mcp-header": "owner"
      },
      "repo": {
        "description": "Repository name",
        "type": "string",
        "x-mcp-header": "repo"
      }
    },
    "required": [
      "owner",
      "repo",
      "comment_id",
      "classifier"
    ],
    "type": "object"
  },
  "name": "hide_issue_comment",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "is_minimized": {
        "type": "boolean"
      },
      "minimized_reason": {
        "description": "GitHub's lowercase, hyphenated reason (for example off-topic); omitted when unhidden.",
        "type": "string"
      },
      "node_id": {
        "type": "string"
      }
    },
    "required": [
      "node_id",
      "is_minimized"
    ],
    "type": "object"
  }
}